# =============================================================================
# CineMind AI - environment template
# Copy to .env and fill in real values. NEVER commit .env or real API keys.
# `.env` and `*.key` are listed in .gitignore.
# =============================================================================

# ---------- MySQL 8 (required) ----------
MYSQL_DATABASE=cinemind
MYSQL_USER=cinemind
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# ---------- Gemini Flash (AI Orchestrator only) ----------
# Get a key from https://aistudio.google.com/app/apikey
# Leave unset/placeholder to start in DEGRADED mode: /api/recommendations/health
# reports DEGRADED and POST /api/recommendations returns 503 with no Gemini call.
# Do NOT set it to an empty string (Spring AI needs a non-blank value at startup).
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ---------- Ollama (local embeddings, NOT in Docker Compose) ----------
# For a local JVM use http://localhost:11434
# From inside a Docker container use http://host.docker.internal:11434
# Pull the model first: ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# nomic-embed-text outputs 768 dimensions; keep in sync if you change the model.
EMBEDDING_DIMENSION=768

# ---------- Service discovery ----------
# Docker Compose uses the service name; local JVMs use localhost.
EUREKA_URL=http://discovery-server:8761/eureka/

# ---------- CORS / frontend ----------
# Must include the origin the Angular app is served from.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---------- Host port mapping (override if a port is already in use) ----------
DISCOVERY_SERVER_PORT=8761
GATEWAY_PORT=8080
MOVIE_SERVICE_PORT=8081
RAG_SERVICE_PORT=8083
ORCHESTRATOR_PORT=8084
FRONTEND_PORT=4200
MYSQL_PORT=3306

# ---------- Local (non-Docker) JDBC host ----------
# Used by a JVM running on the host. Compose sets MYSQL_HOST=mysql instead.
MYSQL_HOST=localhost
